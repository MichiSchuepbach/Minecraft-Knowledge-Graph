           mc:yields 1 .

_:genid11 rdf:type mc:IngredientRequirement ;
           mc:requiredItem mc:IronIngot ;
           mc:amount 3 .

_:genid12 rdf:type mc:IngredientRequirement ;
           mc:requiredItem mc:Stick ;
