@prefix : <http://www.minecraft.example/url/2002/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix mc: <http://www.minecraft.example/url/2002/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.minecraft.example/url/2002/> .

<http://www.minecraft.example/url/2002/> rdf:type owl:Ontology ;
                                          dc:creator "Michael Schüpbach" ;
                                          dc:date "2026-08-18" ;
                                          dc:description "Formale RDFS-Ontologie zur semantischen Beschreibung von Gegenständen, Blöcken, Werkzeugen, Herstellungsstationen und Rezepten im Minecraft-Universum."@de ;
                                          dc:title "Minecraft Item & Crafting Schema"@de ,
                                                   "Minecraft Item & Crafting Schema"@en ;
                                          rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
                                          rdfs:label "Minecraft Knowledge Graph Ontology"@de ,
                                                     "Minecraft Knowledge Graph Ontology"@en ;
                                          rdfs:seeAlso <https://minecraft.wiki/> ;
                                          owl:versionInfo "2.0 (RDFS Extended)" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/date
dc:date rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
dc:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
dc:title rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.minecraft.example/url/2002/canMine
mc:canMine rdf:type owl:ObjectProperty ;
           owl:inverseOf mc:minedWith .


###  http://www.minecraft.example/url/2002/craftedAt
mc:craftedAt rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain mc:Recipe ;
             rdfs:range mc:CraftingStation ;
             rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
             rdfs:label "crafted at"@en ,
                        "hergestellt an"@de .


###  http://www.minecraft.example/url/2002/harvestedWith
mc:harvestedWith rdf:type owl:ObjectProperty ;
                 owl:equivalentProperty mc:minedWith ;
                 rdfs:domain mc:Block ;
                 rdfs:range mc:Tool ;
                 rdfs:comment "Äquivalente Eigenschaft zu minedWith zur Harmonisierung alternativer Vokabulare."@de ;
                 rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
                 rdfs:label "geerntet mit"@de ,
                            "harvested with"@en .


###  http://www.minecraft.example/url/2002/hasItemCode
mc:hasItemCode rdf:type owl:ObjectProperty ,
                        owl:InverseFunctionalProperty ;
               rdfs:domain mc:Item ;
               rdfs:range rdfs:Resource ;
               rdfs:comment "Eindeutiger Primärschlüssel für Gegenstände (invers-funktional: maximal 1 Gegenstand pro Code)."@de ;
               rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
               rdfs:label "has item code"@en ,
                          "hat Item-Code"@de .


###  http://www.minecraft.example/url/2002/hasRecipe
mc:hasRecipe rdf:type owl:ObjectProperty ;
             rdfs:domain mc:Item ;
             rdfs:range mc:Recipe ;
             rdfs:comment "Verknüpft ein herstellbares Item mit dessen zugehörigem Rezept."@de ;
             rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
             rdfs:label "has recipe"@en ,
                        "hat Rezept"@de .


###  http://www.minecraft.example/url/2002/isAdjacentTo
mc:isAdjacentTo rdf:type owl:ObjectProperty ,
                         owl:SymmetricProperty ;
                rdfs:domain mc:Block ;
                rdfs:range mc:Block ;
                rdfs:comment "Gibt eine symmetrische Nachbarschaftsbeziehung zwischen platzierten Blöcken an."@de ;
                rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
                rdfs:label "grenzt an"@de ,
                           "is adjacent to"@en .


###  http://www.minecraft.example/url/2002/minedWith
mc:minedWith rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf mc:requiresInteractionTool ;
             rdfs:domain mc:Block ;
             rdfs:range mc:Tool ;
             rdfs:comment "Bestimmt das Werkzeug, mit dem ein Block in der Welt abgebaut werden kann."@de ;
             rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
             rdfs:label "abgebaut mit"@de ,
                        "mined with"@en .


###  http://www.minecraft.example/url/2002/requiredItem
mc:requiredItem rdf:type owl:ObjectProperty ;
                rdfs:domain mc:IngredientRequirement ;
                rdfs:range mc:Item ;
                rdfs:comment "Verweist von einer Zutatenanforderung auf das konkrete benötigte Item."@de ;
                rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
                rdfs:label "benötigter Gegenstand"@de ,
                           "required item"@en .


###  http://www.minecraft.example/url/2002/requiresIngredient
mc:requiresIngredient rdf:type owl:ObjectProperty ;
                      rdfs:domain mc:Recipe ;
                      rdfs:range mc:IngredientRequirement ;
                      rdfs:comment "Verknüpft ein Rezept mit einem Zutaten-Anforderungsknoten."@de ;
                      rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
                      rdfs:label "benötigt Zutat"@de ,
                                 "requires ingredient"@en .


###  http://www.minecraft.example/url/2002/requiresInteractionTool
mc:requiresInteractionTool rdf:type owl:ObjectProperty ;
                           rdfs:domain mc:Item ;
                           rdfs:range mc:Tool ;
                           rdfs:comment "Allgemeine Eigenschaft: Gibt an, dass für die Nutzung ein Werkzeug erforderlich ist."@de ;
                           rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
                           rdfs:label "benötigt Interaktionswerkzeug"@de ,
                                      "requires tool"@en .


###  http://www.minecraft.example/url/2002/requiresMaterial
mc:requiresMaterial rdf:type owl:ObjectProperty ;
                    rdfs:domain mc:Item ;
                    rdfs:range mc:Item ;
                    owl:propertyChainAxiom ( mc:hasRecipe
                                             mc:requiresIngredient
                                             mc:requiredItem
                                           ) ;
                    rdfs:comment "Verbindet ein herstellbares Item direkt mit seinen benötigten Ausgangsmaterialien (verkürzt den Pfad über Rezept und Zutatenanforderung)."@de ;
                    rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
                    rdfs:label "benötigt Material"@de ,
                               "requires material"@en .


###  http://www.minecraft.example/url/2002/unlocksTierOf
mc:unlocksTierOf rdf:type owl:ObjectProperty ,
                          owl:TransitiveProperty ;
                 rdfs:domain mc:Tool ;
                 rdfs:range mc:Tool ;
                 rdfs:comment "Gibt eine transitive Progressionsstufe zwischen Werkzeugen an."@de ;
                 rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
                 rdfs:label "schaltet Stufe frei"@de ,
                            "unlocks tier of"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.minecraft.example/url/2002/amount
mc:amount rdf:type owl:DatatypeProperty ;
          rdfs:domain mc:IngredientRequirement ;
          rdfs:range rdfs:Literal ;
          rdfs:comment "Die genaue Anzahl der Einheiten dieses Gegenstands für das Rezept."@de ;
          rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
          rdfs:label "Menge"@de ,
                     "amount"@en .


###  http://www.minecraft.example/url/2002/hasName
mc:hasName rdf:type owl:DatatypeProperty ;
           rdfs:domain mc:Item ;
           rdfs:range rdfs:Literal ;
           rdfs:comment "Der menschenlesbare Anzeigename eines Gegenstands oder einer Entität im Spiel."@de ;
           rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
           rdfs:label "has name"@en ,
                      "hat Name"@de .


###  http://www.minecraft.example/url/2002/yields
mc:yields rdf:type owl:DatatypeProperty ;
          rdfs:domain mc:Recipe ;
          rdfs:range rdfs:Literal ;
          rdfs:comment "Die Stückzahl des Ziel-Items, die bei erfolgreicher Herstellung entsteht."@de ;
          rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
          rdfs:label "ergibt Ausbeute"@de ,
                     "yields count"@en .


#################################################################
#    Classes
#################################################################

###  http://www.minecraft.example/url/2002/Block
mc:Block rdf:type owl:Class ;
         rdfs:subClassOf mc:Item ;
         rdfs:comment "Ein Gegenstand, der als 3D-Block in der Spielwelt platziert oder abgebaut werden kann."@de ;
         rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
         rdfs:label "Block"@de ,
                    "Block"@en .


###  http://www.minecraft.example/url/2002/CraftingStation
mc:CraftingStation rdf:type owl:Class ;
                   owl:equivalentClass mc:Workstation ;
                   rdfs:subClassOf mc:Block ;
                   rdfs:comment "Ein Block oder Ort, an dem Rezepte ausgeführt werden können (z. B. Werkbank, Ofen)."@de ;
                   rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
                   rdfs:label "Crafting Station"@en ,
                              "Herstellungsstation"@de .


###  http://www.minecraft.example/url/2002/IngredientRequirement
mc:IngredientRequirement rdf:type owl:Class ;
                         rdfs:subClassOf rdfs:Resource ;
                         rdfs:comment "Repräsentiert die Kombination aus einem benötigten Item und der Stückzahl im Rezept."@de ;
                         rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
                         rdfs:label "Ingredient Requirement"@en ,
                                    "Zutatenanforderung"@de .


###  http://www.minecraft.example/url/2002/Item
mc:Item rdf:type owl:Class ;
        rdfs:subClassOf rdfs:Resource ;
        rdfs:comment "Oberklasse für alle sammelbaren, nutzbaren oder platzierbaren Entitäten im Spiel."@de ;
        rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
        rdfs:label "Gegenstand"@de ,
                   "Item"@en .


###  http://www.minecraft.example/url/2002/Material
mc:Material rdf:type owl:Class ;
            rdfs:subClassOf mc:Item ;
            rdfs:comment "Grundlegende Rohstoffe oder Zwischenprodukte (z. B. Stock, Diamant, Eisenbarren)."@de ;
            rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
            rdfs:label "Material"@de ,
                       "Material"@en .


###  http://www.minecraft.example/url/2002/Recipe
mc:Recipe rdf:type owl:Class ;
          rdfs:subClassOf rdfs:Resource ;
          rdfs:comment "Eine Herstellungsanleitung, die Zutaten und eine Station zu einem Ergebnis verknüpft."@de ;
          rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
          rdfs:label "Recipe"@en ,
                     "Rezept"@de .


###  http://www.minecraft.example/url/2002/SmeltingRecipe
mc:SmeltingRecipe rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty mc:craftedAt ;
                                        owl:hasValue mc:Furnace
                                      ] ;
                  rdfs:subClassOf mc:Recipe ;
                  rdfs:comment "Klasse aller Herstellungsrezepte, die zwingend in einem Schmelzofen ausgeführt werden müssen."@de ;
                  rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
                  rdfs:label "Schmelzrezept"@de ,
                             "Smelting Recipe"@en .


###  http://www.minecraft.example/url/2002/Tool
mc:Tool rdf:type owl:Class ;
        rdfs:subClassOf mc:Item ;
        rdfs:comment "Ein Ausrüstungsgegenstand zur Umweltinteraktion (z. B. Spitzhacke, Axt)."@de ;
        rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
        rdfs:label "Tool"@en ,
                   "Werkzeug"@de .


###  http://www.minecraft.example/url/2002/Workstation
mc:Workstation rdf:type owl:Class ;
               rdfs:subClassOf mc:Block ;
               rdfs:comment "Synonyme Klasse zu CraftingStation zur Angleichung externer Vokabulare."@de ;
               rdfs:isDefinedBy <http://www.minecraft.example/url/2002/> ;
               rdfs:label "Arbeitsstation"@de ,
                          "Workstation"@en .


###  http://www.w3.org/2000/01/rdf-schema#Resource
rdfs:Resource rdf:type owl:Class ;
              rdfs:subClassOf owl:Thing .


#################################################################
#    Individuals
#################################################################

###  http://www.minecraft.example/url/2002/Cobblestone
mc:Cobblestone rdf:type owl:NamedIndividual ,
                        mc:Block ,
                        mc:Item ,
                        rdfs:Resource ,
                        owl:Thing ;
               mc:harvestedWith mc:WoodenPickaxe ;
               mc:hasItemCode mc:ID_Cobble_04 ;
               mc:minedWith mc:WoodenPickaxe ;
               mc:requiresInteractionTool mc:WoodenPickaxe ;
               mc:hasName "Bruchstein"@de ,
                          "Cobblestone"@en .


###  http://www.minecraft.example/url/2002/Craftingtable
mc:Craftingtable rdf:type owl:NamedIndividual ,
                          mc:Block ,
                          mc:CraftingStation ,
                          mc:Item ,
                          mc:Workstation ,
                          rdfs:Resource ,
                          owl:Thing ;
                 owl:sameAs mc:WorkBench ;
                 mc:hasRecipe _:genid5 ;
                 mc:isAdjacentTo mc:Furnace ,
                                 mc:SmeltingFurnace ;
                 mc:requiresMaterial mc:OakPlanks ;
                 mc:hasName "Crafting Table"@en ,
                            "Werkbank"@de .

_:genid5 rdf:type mc:Recipe ;
          mc:requiresIngredient _:genid6 ;
          mc:yields 1 .

_:genid6 rdf:type mc:IngredientRequirement ;
          mc:requiredItem mc:OakPlanks ;
          mc:amount 4 .


