    "kind": 2,
    "language": "sparql",
    "value": "# [endpoint=test_minecraft.ttl]\nPREFIX mc: <http://www.minecraft.example/url/2002/>\n\nSELECT ?element ?name\nWHERE {\n  ?element mc:hasName ?name . \n}",
