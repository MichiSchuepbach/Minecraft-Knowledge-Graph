    "value": "## SPARQL-Vergleich: `OPTIONAL`-Klausel\n\n### Versuch: Ohne und mit `OPTIONAL` (Strikte Abfrage)\n",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "# [endpoint=test_minecraft.ttl]\nPREFIX mc: <http://www.minecraft.example/url/2002/>\n\nSELECT ?item ?werkzeug\nWHERE {\n  ?item mc:hasName ?name .\n  ?item mc:minedWith ?werkzeug .\n}",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "# [endpoint=test_minecraft.ttl]\nPREFIX mc: <http://www.minecraft.example/url/2002/>\n\nSELECT ?item ?werkzeug\nWHERE {\n  ?item mc:hasName ?name .\n  OPTIONAL {\n    ?item mc:minedWith ?werkzeug .\n  }\n}",
    "metadata": {}
