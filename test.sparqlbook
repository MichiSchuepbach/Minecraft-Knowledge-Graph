  {
    "kind": 2,
    "language": "sparql",
    "value": "# [endpoint=test_minecraft.ttl]\nPREFIX mc: <http://www.minecraft.example/url/2002/>\n\nSELECT ?item ?ertrag\nWHERE {\n  ?item mc:hasRecipe ?rezept .\n  ?rezept mc:yields ?ertrag .\n  FILTER (?ertrag >= 4)\n}",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "# [endpoint=test_minecraft.ttl]\nPREFIX mc: <http://www.minecraft.example/url/2002/>\n\nSELECT ?item ?name ?ertrag\nWHERE {\n  ?item mc:hasName ?name ;\n        mc:hasRecipe ?rezept .\n  ?rezept mc:yields ?ertrag .\n\n  FILTER (lang(?name) = \"de\" && ?ertrag = 4)\n}",
    "metadata": {}
